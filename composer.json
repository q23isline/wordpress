{
    "name": "wordpress/app",
    "description": "WordPress skeleton app",
    "license": "GPLv2",
    "version": "1.0.0",
    "require-dev": {
        "wp-coding-standards/wpcs": "^2.3",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@stan"
        ],
        "cs-check": "phpcs --colors -p --standard=WordPress wp-content/themes/",
        "stan": "phpstan analyse"
    }
}
